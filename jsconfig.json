{
    "compilerOptions": {
        "paths": {
            "@js/*": ["./resources/js/*"],
            "@css/*": ["./resources/css/*"]
        },
        "jsx": "preserve",
        "allowImportingTsExtensions": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true
    },
    "include": [
        "resources/js/**/*"
    ],
    "exclude": [
        "node_modules",
        "vendor",
        "public"
    ]
}
